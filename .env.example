# Local development only. Generate the key as described in docs/INSTALLATION.md.
# Do not copy a production key, session, token or database into this file.
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_BASE64
APP_ORIGIN=http://127.0.0.1:4173
# Production ENCRYPTION_KEY is created by npm run setup as a Cloudflare Secret.
# Production APP_ORIGIN is optional; when omitted, the request origin is used.
# If explicitly set in production, use the actual HTTPS origin without a path.
